{
  "manifest_version": 3,
  "name": "Puddle",
  "version": "0.1.0",
  "description": "A duck that lives in your cart. It knows what you own and what you send back, and it speaks up before you pay.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Puddle",
    "default_icon": {
      "16": "icons/duck-16.png",
      "48": "icons/duck-48.png",
      "128": "icons/duck-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5500/*",
        "http://127.0.0.1:5500/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://www.amazon.com/*",
        "https://amazon.com/*"
      ],
      "js": [
        "transport.js",
        "extract.js",
        "speech.js",
        "voice.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "permissions": [
    "storage"
  ],
  "icons": {
    "16": "icons/duck-16.png",
    "48": "icons/duck-48.png",
    "128": "icons/duck-128.png"
  }
}
