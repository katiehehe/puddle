.venv/
brain/.venv/
data/
web/node_modules/
# web/dist is committed on purpose. Vercel deploys one Python function and the
# repo has no root package.json, so nothing there ever runs `npm run build`.
# The brain mounts this directory at /dashboard only when it exists, so without
# it the deployed site answers "Dashboard not built".
# Rebuild and recommit it when the frontend changes.
__pycache__/
*.pyc
.DS_Store

*.sqlite3
*.sqlite3-*

*.egg-info/
.pytest_cache/
.ruff_cache/

.env
.env.*
!.env.example
