.venv/
brain/.venv/
data/
web/node_modules/
# web/dist is committed on purpose: vercel.json builds only api/index.py, and
# its `builds` key disables buildCommand, so nothing on Vercel runs `npm run
# build`. The brain serves this directory at /dashboard, and mounts it only if
# it exists -- without it the deployed site says "Dashboard not built".
# Rebuild and recommit it when the frontend changes.
__pycache__/
*.pyc
.DS_Store

*.sqlite3
*.sqlite3-*

*.egg-info/
.pytest_cache/
.ruff_cache/

.env
.env.*
!.env.example
