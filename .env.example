# Copy this file to .env and add your key there. Never commit .env.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PAYMENT_INTENT_SECRET=
# Visa sandbox: either enrol a project by hand (see docs/demo-runbook.md) or
# restore a previous enrolment with `source scripts/restore_visa_creds.sh`.
PUDDLE_VISA_BUNDLE=
# Optional: a small LLM phrases the duck's verdict and answers Ask Puddle from
# the closet facts. Leave both empty and the deterministic text is used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# PUDDLE_ANTHROPIC_KEY=       # alternative name for the Anthropic key, read first by Ask Puddle
# PHRASE_PROVIDER=anthropic   # openai | anthropic | none, when both keys are set
